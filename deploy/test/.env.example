# .env тестового контура honeybot. Копируется в корень репозитория:  cp deploy/test/.env.example .env
# Отличия от боевого .env.example помечены «ТЕСТ». Инструкция: deploy/test/README.md.

#--- ТЕСТ: размещение (нет отдельного диска RAID5 — данные на том же диске, что и приложение)
# каталог данных: внутри него postgres_honey, media_honey, logs_honey (абсолютный путь)
DATA_DIR=/srv/honeybot-test/data
# бэкапы тестовой базы (ops/backup.sh, перед каждой выкаткой и по cron)
BACKUP_DIR=/srv/honeybot-test/backups
# префикс имён контейнеров — как в deploy/test/docker-compose.override.yml (по нему ищут контейнеры скрипты ops/)
CONTAINER_PREFIX=test_

#--- лог-вьюер (ТЕСТ: открыт через шлюз на test-logger.easy-sochi.ru — только с basic-auth!)
# ТЕСТ: свои порты — тест может жить на одном сервере с боевым контуром
LOG_VIEWER_PORT=8180
LOG_VIEWER_HOST=0.0.0.0
LOG_VIEWER_BIND=127.0.0.1
APP_ENV=test
LOG_LEVEL=DEBUG
SQL_ECHO=false
SLOW_QUERY_MS=500
LOG_DIR=/app/logs
STATE_FILE=/app/state/bot_state.pickle
MEDIA_DIR=/app/media
ENABLE_LOG_VIEWER=true

#--- домены (ТЕСТ)
DOMAIN_HONEY=test.easy-sochi.ru

#--- витрина и админка (ТЕСТ: test.easy-sochi.ru через шлюз → WEB_PORT)
WEBAPP_URL=https://test.easy-sochi.ru/
WEBAPP_AUTH_MAX_AGE_HOURS=24
WEB_PORT=8190
WEB_BIND=127.0.0.1

#--- ВКонтакте (ТЕСТ: отдельное тестовое приложение и сообщество или пусто — VK выключен)
VK_APP_ID=
VK_APP_SECRET=
VK_GROUP_ID=
VK_GROUP_TOKEN=

#--- магазины
STOREFRONT_SHOP=kraspolhoney

#--- контакты (ТЕСТ: тестовая группа продавцов, тестовый чат мониторинга)
ADMIN_CHAT_ID=-100xxxxxxxxxx
DB_MONITOR_CHAT_ID=-100xxxxxxxxxx
DB_MONITOR_HEARTBEAT_MINUTES=0
OWNER_ID=xxxxxxxxx
MANAGER_LIST=TG_ID
SELLER_CONTACT=+7900xxxxxxx

#--- PostgreSQL (ТЕСТ: своя база, свой порт на хосте)
DB_HOST=db_honey
POSTGRES_DB=honey_test
POSTGRES_USER=honey_test
POSTGRES_PASSWORD=придумайте-длинный-пароль
POSTGRES_PORT=5435
POSTGRES_BIND=127.0.0.1

#--- Бот (ТЕСТ: ОТДЕЛЬНЫЙ тестовый бот из @BotFather — не токен боевого бота!
# Два процесса с одним токеном мешают друг другу: Telegram отдаёт обновления только одному.)
BOT_TOKEN=XXXXXXXXXX:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
