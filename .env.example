#лог-вьюер
LOG_VIEWER_PORT=8080
LOG_VIEWER_HOST=0.0.0.0
APP_ENV=production
LOG_LEVEL=INFO
# true — писать SQL с параметрами (только для локальной отладки, в логах окажутся персональные данные)
SQL_ECHO=false
# запросы дольше порога (мс) пишутся в лог как WARNING
SLOW_QUERY_MS=500
# адрес публикации порта вьюера на хосте; 0.0.0.0 — открыть наружу (вьюер без авторизации!)
LOG_VIEWER_BIND=127.0.0.1
LOG_DIR=/app/logs
# состояние диалогов между перезапусками (том bot_state_honey); пусто — не сохранять
STATE_FILE=/app/state/bot_state.pickle
# фото товаров (том bot_media_honey); в БД хранится только ключ файла
MEDIA_DIR=/app/media
ENABLE_LOG_VIEWER=true

#домены 
DOMAIN_HONEY=honey.easy-sochi.ru
 
#магазины
# slug магазина-витрины: бот показывает только его каталог. Пусто — маркетплейс (все магазины)
STOREFRONT_SHOP=kraspolhoney

#контакты
# ADMIN_CHAT_ID и SELLER_CONTACT — только первичное заполнение: при первом старте после миграций
# они записываются в БД как служебный чат и телефон магазина-витрины; дальше бот берёт их из БД
# (shop_channels, shops.contact_phone), изменение здесь уже ни на что не влияет.
ADMIN_CHAT_ID=-xxxxxxxxxxxxxxxxxxxxx
# чат для сообщений мониторинга БД (по умолчанию прежний канал)
DB_MONITOR_CHAT_ID=-1002843679066
# «база доступна» раз в N минут; при смене состояния (упала / восстановилась) сообщение приходит сразу. 0 — только при смене
DB_MONITOR_HEARTBEAT_MINUTES=30
OWNER_ID=xxxxxxxxxxxxxxxxxxx
# Только для первого запуска: если в БД ещё нет менеджеров, эти Telegram ID станут менеджерами.
# Дальше менеджеров назначает владелец (OWNER_ID) командами /managers и /manager_add в боте.
MANAGER_LIST=TG_ID,TG_ID
SELLER_CONTACT=+7988xxxxxxxx

#PostgreSQL
SERVER_IP=xxx.xxx.xxx.xxx
DB_HOST=db_honey
POSTGRES_DB=xxxxxxx_xxxxxx
POSTGRES_USER=xxxxxx-xxxxx-xxxxx
POSTGRES_PASSWORD=xxxxxxxxxxxxxxx
POSTGRES_PORT=5335
# адрес публикации порта БД на хосте; 0.0.0.0 — открыть наружу
POSTGRES_BIND=127.0.0.1
# Адрес БД собирается в bot/config.py из POSTGRES_* и DB_HOST; порт внутри docker-сети — DB_PORT (по умолчанию 5432)

#Бот
BOT_TOKEN=XXXXXXXXXX:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
