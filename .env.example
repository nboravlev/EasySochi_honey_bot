#лог-вьюер
LOG_VIEWER_PORT=8080
LOG_VIEWER_HOST=0.0.0.0
APP_ENV=production
LOG_LEVEL=INFO
# true — писать SQL с параметрами (только для локальной отладки, в логах окажутся персональные данные)
SQL_ECHO=false
# адрес публикации порта вьюера на хосте; 0.0.0.0 — открыть наружу (вьюер без авторизации!)
LOG_VIEWER_BIND=127.0.0.1
LOG_DIR=/app/logs
ENABLE_LOG_VIEWER=true

#домены 
DOMAIN_HONEY=honey.easy-sochi.ru
 
#контакты
ADMIN_CHAT_ID=-xxxxxxxxxxxxxxxxxxxxx
# чат для сообщений мониторинга БД (по умолчанию прежний канал)
DB_MONITOR_CHAT_ID=-1002843679066
OWNER_ID=xxxxxxxxxxxxxxxxxxx
MANAGER_LIST=TG_ID,TG_ID
SELLER_CONTACT=+7988xxxxxxxx

#PostgreSQL
SERVER_IP=xxx.xxx.xxx.xxx
DB_HOST=db_honey
POSTGRES_DB=xxxxxxx_xxxxxx
POSTGRES_USER=xxxxxx-xxxxx-xxxxx
POSTGRES_PASSWORD=xxxxxxxxxxxxxxx
POSTGRES_PORT=5335
# адрес публикации порта БД на хосте; 0.0.0.0 — открыть наружу
POSTGRES_BIND=127.0.0.1
DATABASE_URL=postgresql+asyncpg://user:pass@db_honey:5335/db_name
DATABASE_URL_SYNC=postgresql+psycopg2://user:pass@db_honey:5335/db_name

#карта
MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

#Бот
BOT_TOKEN=XXXXXXXXXX:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
